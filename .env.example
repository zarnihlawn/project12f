# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Comma-separated emails that can access /sudoer
SUDOER_EMAILS="you@example.com"

# Optional SMTP (without these, auth OTPs / reset emails log to the server console)
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@example.com"
