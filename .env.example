# Runtime env (adapter-node / Docker / Fly).
# Never commit real secrets. `.dockerignore` excludes `.env` from image builds.
#
# Required at container start (Fly: `fly secrets set ...`):
DATABASE_URL="postgres://user:password@host:port/db-name"
ORIGIN="http://localhost:5173"
# Must match how you open the app in the browser (localhost vs 127.0.0.1).
# Auth now also trusts common local loopback origins/ports.
BETTER_AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Comma-separated emails that can access /sudoer (can be empty)
SUDOER_EMAILS="you@example.com"

# SMTP (Namecheap Private Email example)
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="465"
SMTP_USER="noreply@example.com"
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
